{
  "name": "reliacare-backend",
  "version": "1.0.0",
  "description": "Healthcare Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm run copy:prisma",
    "build:full": "pnpm run generate && pnpm run build",
    "copy:prisma": "cp -r src/db/postgres/generated dist/db/postgres/ 2>/dev/null || true && cp -r src/db/mongodb/generated dist/db/mongodb/ 2>/dev/null || true",
    "start": "node production.js",
    "start:cross-env": "cross-env NODE_ENV=production node -r tsconfig-paths/register dist/index.js",
    "start:win": "set NODE_ENV=production&& node -r tsconfig-paths/register dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch --require tsconfig-paths/register src/index.ts",
    "debug": "cross-env NODE_ENV=development tsx --inspect-brk --require tsconfig-paths/register src/index.ts",
    "debug:win": "set NODE_ENV=development&& tsx --inspect-brk src/index.ts",
    "test": "cross-env NODE_ENV=test jest",
    "execute": "jest --silent",
    "execute:watch": "jest --watch --silent",
    "execute:unit": "jest --testNamePattern=unit --silent",
    "execute:integration": "jest --testNamePattern=integration --silent",
    "execute:coverage": "jest --coverage --coverageReporters=text-summary",
    "execute:coverage:full": "jest --coverage",
    "execute:ci": "jest --ci --coverage --watchAll=false --silent",
    "dev:win": "set NODE_ENV=development&& tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "generate:postgres": "prisma generate --schema=src/db/postgres/schema.prisma",
    "generate:mongodb": "prisma generate --schema=src/db/mongodb/schema.prisma",
    "generate": "pnpm generate:postgres && pnpm generate:mongodb",
    "studio:postgres": "prisma studio --schema=src/db/postgres/schema.prisma",
    "studio:mongodb": "prisma studio --schema=src/db/mongodb/schema.prisma",
    "pull:postgres": "prisma db pull --force --schema=src/db/postgres/schema.prisma",
    "pull:mongodb": "prisma db pull --schema=src/db/mongodb/schema.prisma",
    "pull": "pnpm pull:postgres && pnpm pull:mongodb",
    "db:clean": "rimraf src/db/postgres/generated src/db/mongodb/generated",
    "db:sync": "pnpm pull && pnpm generate",
    "db:fresh": "pnpm db:clean && pnpm pull --force && pnpm generate",
    "db:setup": "cd database/postgres/sql && sh nonprod_postgres_runscript.sh reliacare root biddiaSQL && cd ../../../ && pnpm pull:postgres && pnpm generate:postgres"
  },
  "keywords": [
    "healthcare",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.16.0"
  },
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/client-secrets-manager": "^3.823.0",
    "@aws-sdk/client-ses": "^3.823.0",
    "@aws-sdk/client-sns": "^3.823.0",
    "@aws-sdk/credential-providers": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.830.0",
    "@prisma/client": "^6.10.1",
    "@smithy/middleware-retry": "^4.0.5",
    "@smithy/util-retry": "^4.0.5",
    "@types/ms": "^2.1.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "node-cron": "^4.0.7",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/deep-diff": "^1.0.5",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.14",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-import-resolver-typescript": "^4.4.1",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "jest-mock": "30.0.0-beta.3",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
