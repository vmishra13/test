{
  "info": {
    "name": "ReliaCare Auth API",
    "description": "Authentication endpoints for ReliaCare backend API",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "OAuth 2.0 Endpoints",
      "item": [
        {
          "name": "1. Login (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    // OAuth 2.0 compliance",
                  "    pm.expect(response).to.have.property('access_token');",
                  "    pm.expect(response).to.have.property('refresh_token');",
                  "    pm.expect(response).to.have.property('expires_in');",
                  "    pm.expect(response).to.have.property('refresh_expires_in');",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    ",
                  "    // ReliaCare specific",
                  "    pm.expect(response).to.have.property('user');",
                  "    pm.expect(response).to.have.property('success');",
                  "    pm.expect(response.success).to.eql(true);",
                  "    ",
                  "    // Store tokens",
                  "    pm.environment.set('accessToken', response.access_token);",
                  "    pm.environment.set('refreshToken', response.refresh_token);",
                  "    pm.environment.set('userId', response.user.id);",
                  "    ",
                  "    console.log('✅ Login successful, tokens stored');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grant_type\": \"password\",\n    \"username\": \"superadmin\",\n    \"password\": \"TempPass123!\",\n    \"clientId\": 1,\n    \"scope\": \"read write\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "2. OAuth 2.0 Token (Password Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OAuth2 Token Endpoint - Password Grant', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    // Standard OAuth 2.0 response",
                  "    pm.expect(response).to.have.property('access_token');",
                  "    pm.expect(response).to.have.property('token_type');",
                  "    pm.expect(response).to.have.property('expires_in');",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    ",
                  "    // Update tokens",
                  "    pm.environment.set('accessToken', response.access_token);",
                  "    pm.environment.set('refreshToken', response.refresh_token);",
                  "    ",
                  "    console.log('✅ OAuth2 token endpoint working');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grant_type\": \"password\",\n    \"username\": \"superadmin\",\n    \"password\": \"TempPass123!\",\n    \"client_id\": \"1\",\n    \"scope\": \"read write\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "token"]
            }
          }
        },
        {
          "name": "3. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token Refresh', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.data).to.have.property('tokens');",
                  "    pm.expect(response.data.tokens).to.have.property('accessToken');",
                  "    pm.expect(response.data.tokens).to.have.property('refreshToken');",
                  "    ",
                  "    // Update tokens",
                  "    pm.environment.set('accessToken', response.data.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', response.data.tokens.refreshToken);",
                  "    ",
                  "    console.log('✅ Token refreshed successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "4. OAuth 2.0 Token (Refresh Grant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OAuth2 Refresh Grant', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response).to.have.property('access_token');",
                  "    pm.expect(response).to.have.property('refresh_token');",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    ",
                  "    // Update tokens",
                  "    pm.environment.set('accessToken', response.access_token);",
                  "    pm.environment.set('refreshToken', response.refresh_token);",
                  "    ",
                  "    console.log('✅ OAuth2 refresh grant working');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grant_type\": \"refresh_token\",\n    \"refresh_token\": \"{{refreshToken}}\",\n    \"client_id\": \"1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "Protected Endpoints",
      "item": [
        {
          "name": "5. Check Auth Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Check Auth Status', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.data).to.have.property('authenticated');",
                  "    pm.expect(response.data.authenticated).to.eql(true);",
                  "    pm.expect(response.data).to.have.property('user');",
                  "    ",
                  "    console.log('✅ Authentication status verified');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/check",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "check"]
            }
          }
        },
        {
          "name": "6. Validate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validate Token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.data.valid).to.eql(true);",
                  "    pm.expect(response.data).to.have.property('user');",
                  "    pm.expect(response.data).to.have.property('permissions');",
                  "    ",
                  "    console.log('✅ Token validation successful');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/validate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "validate"]
            }
          }
        },
        {
          "name": "7. Get Session Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get Session Info', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.data).to.have.property('totalActiveTokens');",
                  "    ",
                  "    console.log('✅ Session info retrieved');",
                  "    console.log('Active tokens:', response.data.totalActiveTokens);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "session"]
            }
          }
        },
        {
          "name": "8. Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.message).to.include('logout');",
                  "    ",
                  "    // Clear tokens",
                  "    pm.environment.set('accessToken', '');",
                  "    pm.environment.set('refreshToken', '');",
                  "    ",
                  "    console.log('✅ Logout successful, tokens cleared');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        },
        {
          "name": "9. Logout All Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout All Devices', function () {",
                  "    pm.response.to.have.status(200);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response.message).to.include('all');",
                  "    ",
                  "    console.log('✅ Logout all devices successful');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout-all"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Testing",
      "item": [
        {
          "name": "10. Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid Credentials Error', function () {",
                  "    pm.response.to.have.status(401);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response).to.have.property('error');",
                  "    pm.expect(response.error).to.eql('invalid_grant');",
                  "    ",
                  "    console.log('✅ Invalid credentials handled correctly');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grant_type\": \"password\",\n    \"username\": \"superadmin\",\n    \"password\": \"WrongPassword\",\n    \"clientId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "11. Missing Required Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing Fields Validation', function () {",
                  "    pm.response.to.have.status(400);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response).to.have.property('error');",
                  "    pm.expect(response.error).to.eql('invalid_request');",
                  "    pm.expect(response).to.have.property('details');",
                  "    ",
                  "    console.log('✅ Validation errors handled correctly');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"grant_type\": \"password\",\n    \"username\": \"superadmin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "12. Invalid Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid Refresh Token', function () {",
                  "    pm.response.to.have.status(401);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.success).to.eql(false);",
                  "    pm.expect(response).to.have.property('error');",
                  "    ",
                  "    console.log('✅ Invalid refresh token handled correctly');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"invalid_token_here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "13. Unauthorized Access",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthorized Access', function () {",
                  "    pm.response.to.have.status(401);",
                  "    ",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response).to.have.property('error');",
                  "    pm.expect(response.error).to.include('unauthorized');",
                  "    ",
                  "    console.log('✅ Unauthorized access blocked correctly');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "session"]
            }
          }
        }
      ]
    }
  ]
}
