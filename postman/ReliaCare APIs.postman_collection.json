		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "1. OAuth Token (Password Grant)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"    const responseJson = pm.response.json();",
									"    ",
									"    if (pm.response.code === 200 && responseJson.access_token) {",
									"        pm.collectionVariables.set(\"RELIACARE_X_AUTH_TOKEN\", responseJson.access_token);",
									"        console.log(\"✅ Access token stored in collection variable:\", responseJson.access_token);",
									"        ",
									"        if (responseJson.token_type) {",
									"            pm.collectionVariables.set(\"RELIACARE_TOKEN_TYPE\", responseJson.token_type);",
									"        }",
									"        ",
									"        if (responseJson.expires_in) {",
									"            pm.collectionVariables.set(\"RELIACARE_TOKEN_EXPIRES_IN\", responseJson.expires_in);",
									"            const expirationTime = new Date(Date.now() + (responseJson.expires_in * 1000));",
									"            pm.collectionVariables.set(\"RELIACARE_TOKEN_EXPIRES_AT\", expirationTime.toISOString());",
									"        }",
									"        ",
									"        if (responseJson.refresh_token) {",
									"            pm.collectionVariables.set(\"RELIACARE_REFRESH_TOKEN\", responseJson.refresh_token);",
									"        }",
									"        ",
									"        if (responseJson.user) {",
									"            pm.collectionVariables.set(\"CURRENT_USER_ID\", responseJson.user.id);",
									"            pm.collectionVariables.set(\"CURRENT_CLIENT_ID\", responseJson.user.clientId);",
									"        }",
									"    } else {",
									"        console.error(\"❌ Failed to extract access token from response\");",
									"    }",
									"} catch (error) {",
									"    console.error(\"❌ Error processing response:\", error.message);",
									"}",
									"",
									"pm.test(\"Authentication successful\", function () {",
									"    pm.response.to.have.status(200);",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('access_token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"grant_type\": \"password\",\n    \"username\": \"admin@example.com\",\n    \"password\": \"password123\",\n    \"client_id\": \"reliacare-client\",\n    \"scope\": \"read write\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "token"]
						}
					}
				},
