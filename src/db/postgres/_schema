  msgGroupUser   msg_group_user[]  // ADDED
  message        message[]         // ADDED
  userMsgBox     user_msg_box[]    // ADDED

  @@index([crDate], map: "idx_client_crDate")
  @@index([name], map: "idx_client_name")
  @@index([status], map: "idx_client_status")
  @@index([timeZone], map: "idx_client_timeZone")
}

