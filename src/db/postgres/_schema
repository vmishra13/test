generator postgresClient {
  provider = "prisma-client-js"
  output   = "./generated/postgres-client"
}

datasource postgresDb {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model todo {
  id           Int      @id @default(autoincrement())
  title        String   @postgresDb.VarChar(255)
  description  String?
  is_completed Boolean  @default(false)
  created_at   DateTime @default(now()) @postgresDb.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model client {
  id             Int               @id @default(autoincrement())
  name           String            @unique(map: "client_name_unique") @postgresDb.VarChar(100)
  description    String?
  timeZone       String?           @postgresDb.VarChar(100)
  status         Int?              @default(-1)
  logo           String?           @postgresDb.VarChar(2000)
  favIcon        String?           @postgresDb.VarChar(2000)
  language       String?           @postgresDb.VarChar(50)
  website        String?           @postgresDb.VarChar(2000)
  extraInfo      Json?             @postgresDb.Json
  crUser         String            @postgresDb.VarChar(50)
  crDate         DateTime          @default(now()) @postgresDb.Timestamp(6)
  modUser        String?           @postgresDb.VarChar(50)
  modDate        DateTime?         @default(now()) @postgresDb.Timestamp(6)
  clientLocation client_location[]
  contact        contact[]
  refresh_token  refresh_token[]
  user           user[]
  userRole       user_role[]

  @@index([crDate], map: "idx_client_crDate")
  @@index([name], map: "idx_client_name")
  @@index([status], map: "idx_client_status")
  @@index([timeZone], map: "idx_client_timeZone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model client_location {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @postgresDb.VarChar(100)
  description String?
  status      Int?
  logo        String?   @postgresDb.VarChar(2000)
  extraInfo   Json?     @postgresDb.Json
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String?   @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  client      client    @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_client_location_client")
  contact     contact[]

  @@index([clientId], map: "idx_client_location_clientId")
  @@index([clientId, status], map: "idx_client_location_client_status")
  @@index([crDate], map: "idx_client_location_crDate")
  @@index([name], map: "idx_client_location_name")
  @@index([status], map: "idx_client_location_status")
}

