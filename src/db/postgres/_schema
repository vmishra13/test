model refresh_token {
  id        Int       @id @default(autoincrement())
  userId    Int
  clientId  Int
  jti       String    @unique @postgresDb.VarChar(36)
  family    String    @postgresDb.VarChar(36)
  token     String    @postgresDb.VarChar(500)
  expiresAt DateTime  @postgresDb.Timestamp(6)
  isRevoked Boolean?  @default(false)
  crUser    String    @postgresDb.VarChar(50)
  crDate    DateTime? @default(now()) @postgresDb.Timestamp(6)
  client    client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_client")
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_user")

  @@index([family], map: "idx_refresh_token_family")
  @@index([isRevoked], map: "idx_refresh_token_isRevoked")
  @@index([jti], map: "idx_refresh_token_jti")
  @@index([userId], map: "idx_refresh_token_userId")
}
