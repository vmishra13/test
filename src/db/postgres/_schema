model client {
  id             Int               @id @default(autoincrement())
  name           String            @unique(map: "client_name_unique") @postgresDb.VarChar(100)
  description    String?           @postgresDb.Text
  timeZone       String?           @postgresDb.VarChar(100)
  status         Int?              @default(-1)
  logo           String?           @postgresDb.VarChar(2000)
  favIcon        String?           @postgresDb.VarChar(2000)
  language       String?           @postgresDb.VarChar(50)
  website        String?           @postgresDb.VarChar(2000)
  extraInfo      Json?             @postgresDb.Json
  crUser         String            @postgresDb.VarChar(50)
  crDate         DateTime          @default(now()) @postgresDb.Timestamp(6)
  modUser        String?           @postgresDb.VarChar(50)
  modDate        DateTime?         @default(now()) @postgresDb.Timestamp(6)
  
  // Relations
  clientLocation client_location[]
  contact        contact[]
  refresh_token  refresh_token[]
  user           user[]
  userRole       user_role[]
