  userId         Int?
  clientId       Int?
  locationId     Int?
  default        Boolean?         @default(false)
  status         String?          @postgresDb.VarChar(5)
  crUser         String           @postgresDb.VarChar(50)
  crDate         DateTime         @default(now()) @postgresDb.Timestamp(6)
  modUser        String?          @postgresDb.VarChar(50)
  modDate        DateTime?        @default(now()) @postgresDb.Timestamp(6)
  client         client?          @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_contact_client")
  clientLocation client_location? @relation(fields: [locationId], references: [id], onDelete: Cascade, map: "fk_contact_location")
  user           user?            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_contact_user")

  @@index([clientId], map: "idx_contact_clientId")
  @@index([clientId, type], map: "idx_contact_client_type")
  @@index([crDate], map: "idx_contact_crDate")
  @@index([default], map: "idx_contact_default")
  @@index([locationId], map: "idx_contact_locationId")
  @@index([locationId, type], map: "idx_contact_location_type")
  @@index([status], map: "idx_contact_status")
  @@index([type], map: "idx_contact_type")
  @@index([userId], map: "idx_contact_userId")
  @@index([userId, default], map: "idx_contact_user_default")
  @@index([userId, type], map: "idx_contact_user_type")
}

