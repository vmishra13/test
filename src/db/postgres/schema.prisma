generator postgresClient {
  provider = "prisma-client-js"
  output   = "./generated/postgres-client"
}

datasource postgresDb {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

/// Client model with relationships
model client {
  id           Int               @id @default(autoincrement())
  name         String            @postgresDb.VarChar(100)
  description  String?
  timeZone     String            @postgresDb.VarChar(100)
  status       Int?              @default(-1)
  logo         String?           @postgresDb.VarChar(2000)
  favIcon      String?           @postgresDb.VarChar(2000)
  language     String?           @postgresDb.VarChar(50)
  website      String?           @postgresDb.VarChar(2000)
  extraInfo    Json?             @postgresDb.Json
  crUser       String            @postgresDb.VarChar(50)
  crDate       DateTime          @default(now()) @postgresDb.Timestamp(6)
  modUser      String            @postgresDb.VarChar(50)
  modDate      DateTime?         @default(now()) @postgresDb.Timestamp(6)
  locations    client_location[]
  contacts     contact[]
  form_master  form_master[]
  patient_form patient_form[]
  plan         plan[]
  users        user[]
  userRoles    user_role[]
}

/// Client location model with relationships
model client_location {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @postgresDb.VarChar(100)
  description String?
  status      Int?
  logo        String?   @postgresDb.VarChar(2000)
  extraInfo   Json?     @postgresDb.Json
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String    @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  client      client    @relation(fields: [clientId], references: [id], map: "fk_client_location_client")

  @@unique([clientId, name], map: "uk_client_location_client_name")
}

/// Contact model with relationships
model contact {
  id       Int       @id @default(autoincrement())
  type     String    @postgresDb.VarChar(50)
  value    Json      @postgresDb.Json
  userId   Int
  clientId Int
  default  Boolean?  @default(false)
  status   String?   @postgresDb.VarChar(5)
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String    @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], map: "fk_contact_client")
  user     user      @relation(fields: [userId], references: [id], map: "fk_contact_user")
}

/// Password model with relationships
model password {
  id         Int       @id @default(autoincrement())
  userId     Int
  password   String    @postgresDb.VarChar(60)
  expiryDate DateTime? @postgresDb.Date
  status     Int?
  crUser     String    @postgresDb.VarChar(50)
  crDate     DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser    String    @postgresDb.VarChar(50)
  modDate    DateTime? @default(now()) @postgresDb.Timestamp(6)
  user       user      @relation(fields: [userId], references: [id], map: "fk_password_user")
}

/// Role model with relationships
model role {
  id          Int         @id @default(autoincrement())
  name        String      @postgresDb.VarChar(100)
  description String?     @postgresDb.VarChar(100)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime    @default(now()) @postgresDb.Timestamp(6)
  modUser     String      @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)
  userRoles   user_role[]
}

/// User model with relationships
model user {
  id               Int            @id @default(autoincrement())
  clientId         Int
  userTypeId       Int
  loginName        String         @unique(map: "uk_user_login_name") @postgresDb.VarChar(50)
  firstName        String?        @postgresDb.VarChar(50)
  middleName       String?        @postgresDb.VarChar(50)
  lastName         String?        @postgresDb.VarChar(50)
  email            String?        @unique(map: "uk_user_email") @postgresDb.VarChar(100)
  dob              DateTime?      @postgresDb.Date
  mrn              String?        @postgresDb.VarChar(50)
  gender           String?        @postgresDb.VarChar(50)
  timeZone         String?        @postgresDb.VarChar(100)
  profilePicture   String?        @postgresDb.VarChar(2000)
  passExpireInDays Int?
  extraInfo        Json?          @postgresDb.Json
  status           Int?
  crUser           String         @postgresDb.VarChar(50)
  crDate           DateTime       @default(now()) @postgresDb.Timestamp(6)
  modUser          String         @postgresDb.VarChar(50)
  modDate          DateTime?      @default(now()) @postgresDb.Timestamp(6)
  contacts         contact[]
  passwords        password[]
  patient_form     patient_form[]
  client           client         @relation(fields: [clientId], references: [id], map: "fk_user_client")
  userType         user_type      @relation(fields: [userTypeId], references: [id], map: "fk_user_user_type")
  userRoles        user_role[]
}

/// User role model with relationships
model user_role {
  id       Int       @id @default(autoincrement())
  userId   Int
  clientId Int
  roleId   Int
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String    @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], map: "fk_user_role_client")
  role     role      @relation(fields: [roleId], references: [id], map: "fk_user_role_role")
  user     user      @relation(fields: [userId], references: [id], map: "fk_user_role_user")
}

/// User type model with relationships
model user_type {
  id          Int       @id @default(autoincrement())
  name        String    @postgresDb.VarChar(100)
  description String?   @postgresDb.VarChar(100)
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String    @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  users       user[]
}

model diagnosis_master {
  id                                        Int       @id @default(autoincrement())
  name                                      String?   @unique @postgresDb.VarChar(100)
  bodyArea                                  String    @postgresDb.VarChar(100)
  groupType                                 String    @postgresDb.VarChar(100)
  leftICDCode                               String?   @postgresDb.VarChar(50)
  rightICDCode                              String?   @postgresDb.VarChar(50)
  bilateralICDCode                          String?   @postgresDb.VarChar(50)
  noneICDCode                               String?   @postgresDb.VarChar(50)
  crUser                                    String    @postgresDb.VarChar(50)
  crDate                                    DateTime? @default(now()) @postgresDb.Timestamp(6)
  modUser                                   String    @postgresDb.VarChar(50)
  modDate                                   DateTime? @default(now()) @postgresDb.Timestamp(6)
  plan_plan_diagnosisIdTodiagnosis_master   plan[]    @relation("plan_diagnosisIdTodiagnosis_master")
  plan_plan_diagnosisNameTodiagnosis_master plan[]    @relation("plan_diagnosisNameTodiagnosis_master")
}

model patient_form {
  id          Int         @id @default(autoincrement())
  patientId   Int
  clientId    Int
  formId      Int
  processed   Boolean?    @default(false)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime?   @default(now()) @postgresDb.Timestamp(6)
  modUser     String      @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)
  client      client      @relation(fields: [clientId], references: [id], map: "fk_patientform_client")
  form_master form_master @relation(fields: [formId], references: [id], map: "fk_patientform_form_master")
  user        user        @relation(fields: [patientId], references: [id], map: "fk_patientform_user")
}

model plan {
  id                                                    Int              @id @default(autoincrement())
  clientId                                              Int
  name                                                  String           @postgresDb.VarChar(100)
  description                                           String?
  diagnosisId                                           Int
  diagnosisName                                         String           @postgresDb.VarChar(100)
  version                                               Int?             @default(1)
  model                                                 Json?            @postgresDb.Json
  crUser                                                String           @postgresDb.VarChar(50)
  crDate                                                DateTime?        @default(now()) @postgresDb.Timestamp(6)
  modUser                                               String           @postgresDb.VarChar(50)
  modDate                                               DateTime?        @default(now()) @postgresDb.Timestamp(6)
  client                                                client           @relation(fields: [clientId], references: [id], map: "fk_plan_client")
  diagnosis_master_plan_diagnosisIdTodiagnosis_master   diagnosis_master @relation("plan_diagnosisIdTodiagnosis_master", fields: [diagnosisId], references: [id], map: "fk_plan_diagnosis_master")
  diagnosis_master_plan_diagnosisNameTodiagnosis_master diagnosis_master @relation("plan_diagnosisNameTodiagnosis_master", fields: [diagnosisName], references: [name], map: "fk_plan_diagnosis_name")
}

model form_master {
  id           Int            @id @default(autoincrement())
  clientid     Int?           @default(1)
  name         String         @postgresDb.VarChar(255)
  description  String?
  cruser       String         @postgresDb.VarChar(50)
  crdate       DateTime?      @default(now()) @postgresDb.Timestamp(6)
  moduser      String         @postgresDb.VarChar(50)
  moddate      DateTime?      @default(now()) @postgresDb.Timestamp(6)
  client       client?        @relation(fields: [clientid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_form_master_client")
  patient_form patient_form[]
}
