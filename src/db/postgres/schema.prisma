generator postgresClient {
  provider = "prisma-client-js"
  output   = "./generated/postgres-client"
}

datasource postgresDb {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

/// Client model with relationships
model client {
  id             Int               @id @default(autoincrement())
  name           String            @unique @postgresDb.VarChar(100)
  description    String?
  timeZone       String?           @postgresDb.VarChar(100)
  status         Int?              @default(-1)
  logo           String?           @postgresDb.VarChar(2000)
  favIcon        String?           @postgresDb.VarChar(2000)
  language       String?           @postgresDb.VarChar(50)
  website        String?           @postgresDb.VarChar(2000)
  extraInfo      Json?             @postgresDb.Json
  crUser         String            @postgresDb.VarChar(50)
  crDate         DateTime          @default(now()) @postgresDb.Timestamp(6)
  modUser        String?           @postgresDb.VarChar(50)
  modDate        DateTime?         @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  users          user[]
  locations      client_location[]
  contacts       contact[]
  userRoles      user_role[]

  @@index([timeZone])
}

/// Client location model with relationships
model client_location {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @postgresDb.VarChar(100)
  description String?
  status      Int?
  logo        String?   @postgresDb.VarChar(2000)
  extraInfo   Json?     @postgresDb.Json
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String?   @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  client      client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts    contact[]

  @@unique([clientId, name])
  @@index([clientId, status])
}

/// Contact model with relationships
model contact {
  id         Int              @id @default(autoincrement())
  type       String           @postgresDb.VarChar(50)
  value      Json             @postgresDb.Json
  userId     Int?
  clientId   Int?
  locationId Int?
  default    Boolean?         @default(false)
  status     String?          @postgresDb.VarChar(5)
  crUser     String           @postgresDb.VarChar(50)
  crDate     DateTime         @default(now()) @postgresDb.Timestamp(6)
  modUser    String?          @postgresDb.VarChar(50)
  modDate    DateTime?        @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  user       user?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location   client_location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([clientId, type])
}

/// Password model with relationships
model password {
  id         Int       @id @default(autoincrement())
  userId     Int
  password   String    @postgresDb.VarChar(60)
  expiryDate DateTime? @postgresDb.Date
  status     Int?
  crUser     String    @postgresDb.VarChar(50)
  crDate     DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser    String?   @postgresDb.VarChar(50)
  modDate    DateTime? @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiryDate])
}

/// Role model with relationships
model role {
  id          Int         @id @default(autoincrement())
  name        String      @unique @postgresDb.VarChar(100)
  description String?     @postgresDb.VarChar(100)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime    @default(now()) @postgresDb.Timestamp(6)
  modUser     String?     @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  userRoles   user_role[]
}

/// User model with relationships
model user {
  id               Int        @id @default(autoincrement())
  clientId         Int
  userTypeId       Int
  loginName        String     @postgresDb.VarChar(50)
  firstName        String?    @postgresDb.VarChar(50)
  middleName       String?    @postgresDb.VarChar(50)
  lastName         String?    @postgresDb.VarChar(50)
  email            String?    @postgresDb.VarChar(100)
  dob              DateTime?  @postgresDb.Date
  mrn              String?    @postgresDb.VarChar(50)
  gender           String?    @postgresDb.VarChar(50)
  timeZone         String?    @postgresDb.VarChar(100)
  profilePicture   String?    @postgresDb.VarChar(2000)
  passExpireInDays Int?
  extraInfo        Json?      @postgresDb.Json
  status           Int?
  crUser           String     @postgresDb.VarChar(50)
  crDate           DateTime   @default(now()) @postgresDb.Timestamp(6)
  modUser          String?    @postgresDb.VarChar(50)
  modDate          DateTime?  @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  client           client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userType         user_type  @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  passwords        password[]
  contacts         contact[]
  userRoles        user_role[]

  @@unique([loginName, clientId])
  @@unique([email, clientId])
  @@index([clientId])
  @@index([userTypeId])
  @@index([email])
}

/// User role model with relationships
model user_role {
  id       Int       @id @default(autoincrement())
  userId   Int
  clientId Int
  roleId   Int
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String?   @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role     role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, roleId])
  @@index([userId])
  @@index([clientId])
  @@index([roleId])
}

/// User type model with relationships
model user_type {
  id          Int       @id @default(autoincrement())
  name        String    @unique @postgresDb.VarChar(100)
  description String?   @postgresDb.VarChar(100)
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String?   @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)

  // Relationships
  users       user[]
}
