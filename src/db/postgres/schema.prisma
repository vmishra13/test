generator postgresClient {
  provider = "prisma-client-js"
  output   = "./generated/postgres-client"
}

datasource postgresDb {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model auditLog {
  id              Int       @id @default(autoincrement())
  eventType       String?   @postgresDb.VarChar(100)
  entityType      String?   @postgresDb.VarChar(100)
  subEntityType   String?   @postgresDb.VarChar(100)
  entityId        String?   @postgresDb.VarChar(100)
  operationType   String?   @postgresDb.VarChar(100)
  operationStatus String?   @postgresDb.VarChar(100)
  actionType      String?   @postgresDb.VarChar(100)
  actionSubType   String?   @postgresDb.VarChar(100)
  actionSummary   String?
  sourceSystem    String?   @postgresDb.VarChar(100)
  actionUser      Int?
  actionClient    Int?
  actionDate      DateTime? @postgresDb.Timestamp(6)
  spentTime       BigInt?
  comment         String?
  changeLog       Json?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model client {
  id                 Int                  @id @default(autoincrement())
  name               String               @postgresDb.VarChar(100)
  description        String?
  timeZone           String               @postgresDb.VarChar(100)
  status             Int?                 @default(-1)
  logo               String?              @postgresDb.VarChar(2000)
  favIcon            String?              @postgresDb.VarChar(2000)
  language           String?              @postgresDb.VarChar(50)
  website            String?              @postgresDb.VarChar(2000)
  extraInfo          Json?                @postgresDb.Json
  crUser             String               @postgresDb.VarChar(50)
  crDate             DateTime             @default(now()) @postgresDb.Timestamp(6)
  modUser            String               @postgresDb.VarChar(50)
  modDate            DateTime?            @default(now()) @postgresDb.Timestamp(6)
  client_location    client_location[]
  contact            contact[]
  form_master        form_master[]
  medication_master  medication_master[]
  msg_group          msg_group[]
  msg_reply_template msg_reply_template[]
  patient_form       patient_form[]
  plan_user          plan_user[]
  user               user[]
  user_feedback      user_feedback[]
  user_role          user_role[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model client_location {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @postgresDb.VarChar(100)
  description String?
  status      Int?
  logo        String?   @postgresDb.VarChar(2000)
  extraInfo   Json?     @postgresDb.Json
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String    @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  client      client    @relation(fields: [clientId], references: [id], map: "fk_client_location_client")

  @@unique([clientId, name], map: "uk_client_location_client_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contact {
  id       Int       @id @default(autoincrement())
  type     String    @postgresDb.VarChar(50)
  value    Json      @postgresDb.Json
  userId   Int
  clientId Int
  default  Boolean?  @default(false)
  status   String?   @postgresDb.VarChar(5)
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String    @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], map: "fk_contact_client")
  user     user      @relation(fields: [userId], references: [id], map: "fk_contact_user")
}

model diagnosis_master {
  id                           Int                            @id @default(autoincrement())
  name                         String?                        @unique @postgresDb.VarChar(100)
  bodyArea                     String                         @postgresDb.VarChar(100)
  groupType                    String                         @postgresDb.VarChar(100)
  leftICDCode                  String?                        @postgresDb.VarChar(50)
  rightICDCode                 String?                        @postgresDb.VarChar(50)
  bilateralICDCode             String?                        @postgresDb.VarChar(50)
  noneICDCode                  String?                        @postgresDb.VarChar(50)
  crUser                       String                         @postgresDb.VarChar(50)
  crDate                       DateTime?                      @default(now()) @postgresDb.Timestamp(6)
  modUser                      String                         @postgresDb.VarChar(50)
  modDate                      DateTime?                      @default(now()) @postgresDb.Timestamp(6)
  msg_reply_diagnosis_relation msg_reply_diagnosis_relation[]
}

model exercise_master {
  id              Int                  @id @default(autoincrement())
  title           String               @postgresDb.VarChar(100)
  description     String?
  purpose         String?              @postgresDb.VarChar(255)
  media_type      media_type_enum?
  media_url       String?              @postgresDb.VarChar(2048)
  frequencyPeriod frequency_unit_type? @default(Day)
  unit            unit_type?           @default(Set)
  value           Int?                 @default(1)
  setUnit         Int?                 @default(1)
  repetition      Int?                 @default(0)
  procedure       String?              @postgresDb.VarChar(1024)
  note            String?
  show_checkbox   Boolean?
  crUser          String               @postgresDb.VarChar(50)
  crDate          DateTime?            @default(now()) @postgresDb.Timestamp(6)
  modUser         String               @postgresDb.VarChar(50)
  modDate         DateTime?            @default(now()) @postgresDb.Timestamp(6)
}

model form_master {
  id           Int            @id @default(autoincrement())
  clientId     Int?           @default(1)
  name         String         @postgresDb.VarChar(255)
  description  String?
  crUser       String         @postgresDb.VarChar(50)
  crDate       DateTime?      @default(now()) @postgresDb.Timestamp(6)
  modUser      String         @postgresDb.VarChar(50)
  modDate      DateTime?      @default(now()) @postgresDb.Timestamp(6)
  client       client?        @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_form_master_client")
  patient_form patient_form[]
}

model medication_master {
  id           Int               @id @default(autoincrement())
  name         String            @postgresDb.VarChar(255)
  clientId     Int?              @default(1)
  identifier   String?           @postgresDb.VarChar(50)
  code         String?           @postgresDb.VarChar(50)
  dosageForm   dosage_form_type?
  strength     String?           @postgresDb.VarChar(50)
  manufacturer String?           @postgresDb.VarChar(255)
  description  String?
  crUser       String            @postgresDb.VarChar(50)
  crDate       DateTime?         @default(now()) @postgresDb.Timestamp(6)
  modUser      String            @postgresDb.VarChar(50)
  modDate      DateTime?         @default(now()) @postgresDb.Timestamp(6)
  client       client?           @relation(fields: [clientId], references: [id], onDelete: Restrict, map: "fk_medication_master_client")
}

model message {
  id                    Int                     @id @default(autoincrement())
  type                  message_type_enum
  body                  String?
  attachments           Json?                   @postgresDb.Json
  crUser                String                  @postgresDb.VarChar(50)
  crDate                DateTime?               @default(now()) @postgresDb.Timestamp(6)
  modUser               String                  @postgresDb.VarChar(50)
  modDate               DateTime?               @default(now()) @postgresDb.Timestamp(6)
  msg_group             msg_group[]
  msg_group_participant msg_group_participant[]
  msg_group_relation    msg_group_relation[]
}

model msg_group {
  id                    Int                     @id @default(autoincrement())
  type                  msg_group_type_enum
  patientPlanId         Int
  patientId             Int
  clientId              Int
  name                  String                  @postgresDb.VarChar(100)
  description           String?
  active                Boolean?                @default(true)
  lastMsgId             Int?
  lastMsgDate           DateTime?               @postgresDb.Timestamp(6)
  crUser                String                  @postgresDb.VarChar(50)
  crDate                DateTime?               @default(now()) @postgresDb.Timestamp(6)
  modUser               String                  @postgresDb.VarChar(50)
  modDate               DateTime?               @default(now()) @postgresDb.Timestamp(6)
  client                client                  @relation(fields: [clientId], references: [id], map: "fk_msggroup_client")
  message               message?                @relation(fields: [lastMsgId], references: [id], map: "fk_msggroup_message")
  user                  user                    @relation(fields: [patientId], references: [id], map: "fk_msggroup_patient")
  patient_plan          patient_plan            @relation(fields: [patientPlanId], references: [id], map: "fk_msggroup_patient_plan")
  msg_group_participant msg_group_participant[]
  msg_group_relation    msg_group_relation[]
}

model msg_group_participant {
  id                 Int            @id @default(autoincrement())
  msgGroupId         Int
  userId             Int
  userType           user_type_enum
  boxType            box_type_enum
  unreadCount        Int?           @default(0)
  firstUnreadMsgId   Int?
  firstUnreadMsgDate DateTime?      @postgresDb.Timestamp(6)
  validFrom          DateTime?      @postgresDb.Date
  validTo            DateTime?      @postgresDb.Date
  crUser             String         @postgresDb.VarChar(50)
  crDate             DateTime?      @default(now()) @postgresDb.Timestamp(6)
  modUser            String         @postgresDb.VarChar(50)
  modDate            DateTime?      @default(now()) @postgresDb.Timestamp(6)
  message            message?       @relation(fields: [firstUnreadMsgId], references: [id], map: "fk_msgparticipant_message")
  msg_group          msg_group      @relation(fields: [msgGroupId], references: [id], map: "fk_msgparticipant_msg_group")
  user               user           @relation(fields: [userId], references: [id], map: "fk_msgparticipant_user")
}

model msg_group_relation {
  id         Int       @id @default(autoincrement())
  msgGroupId Int
  msgId      Int
  senderId   Int
  extraInfo  Json?     @postgresDb.Json
  crUser     String    @postgresDb.VarChar(50)
  crDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  modUser    String    @postgresDb.VarChar(50)
  modDate    DateTime? @default(now()) @postgresDb.Timestamp(6)
  message    message   @relation(fields: [msgId], references: [id], map: "fk_msgrelation_message")
  msg_group  msg_group @relation(fields: [msgGroupId], references: [id], map: "fk_msgrelation_msg_group")
  user       user      @relation(fields: [senderId], references: [id], map: "fk_msgrelation_sender")
}

model msg_reply_diagnosis_relation {
  id                 Int                @id @default(autoincrement())
  msgReplyTemplateId Int
  diagnosisId        Int
  crUser             String             @postgresDb.VarChar(50)
  crDate             DateTime?          @default(now()) @postgresDb.Timestamp(6)
  modUser            String             @postgresDb.VarChar(50)
  modDate            DateTime?          @default(now()) @postgresDb.Timestamp(6)
  diagnosis_master   diagnosis_master   @relation(fields: [diagnosisId], references: [id], map: "fk_msgreplydiagnosisrel_diagnosis")
  msg_reply_template msg_reply_template @relation(fields: [msgReplyTemplateId], references: [id], map: "fk_msgreplydiagnosisrel_template")
}

model msg_reply_template {
  id                           Int                            @id @default(autoincrement())
  userId                       Int
  clientId                     Int
  question                     String                         @postgresDb.VarChar(500)
  answer                       String                         @postgresDb.VarChar(500)
  crUser                       String                         @postgresDb.VarChar(50)
  crDate                       DateTime?                      @default(now()) @postgresDb.Timestamp(6)
  modUser                      String                         @postgresDb.VarChar(50)
  modDate                      DateTime?                      @default(now()) @postgresDb.Timestamp(6)
  msg_reply_diagnosis_relation msg_reply_diagnosis_relation[]
  client                       client                         @relation(fields: [clientId], references: [id], map: "fk_msgreplytemplate_client")
  user                         user                           @relation(fields: [userId], references: [id], map: "fk_msgreplytemplate_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model password {
  id         Int       @id @default(autoincrement())
  userId     Int
  password   String    @postgresDb.VarChar(60)
  expiryDate DateTime? @postgresDb.Date
  status     Int?
  crUser     String    @postgresDb.VarChar(50)
  crDate     DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser    String    @postgresDb.VarChar(50)
  modDate    DateTime? @default(now()) @postgresDb.Timestamp(6)
  user       user      @relation(fields: [userId], references: [id], map: "fk_password_user")
}

model patient_form {
  id          Int         @id @default(autoincrement())
  patientId   Int
  clientId    Int
  formId      Int
  processed   Boolean?    @default(false)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime?   @default(now()) @postgresDb.Timestamp(6)
  modUser     String      @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)
  client      client      @relation(fields: [clientId], references: [id], map: "fk_patientform_client")
  form_master form_master @relation(fields: [formId], references: [id], map: "fk_patientform_form_master")
  user        user        @relation(fields: [patientId], references: [id], map: "fk_patientform_user")
}

model patient_plan {
  id                        Int                         @id @default(autoincrement())
  patientId                 Int
  clientId                  Int?                        @default(1)
  locationId                Int?
  planId                    Int?
  surgeonId                 Int
  diagnosisId               Int?
  diagnosisName             String?                     @postgresDb.VarChar(100)
  description               String?
  surgeryDate               DateTime                    @postgresDb.Date
  surgeryTime               DateTime                    @postgresDb.Time(6)
  literality                literality_enum?            @default(None)
  model                     Json?                       @postgresDb.Json
  crUser                    String?                     @postgresDb.VarChar(50)
  crDate                    DateTime?                   @default(now()) @postgresDb.Timestamp(6)
  modUser                   String                      @postgresDb.VarChar(50)
  modDate                   DateTime?                   @default(now()) @postgresDb.Timestamp(6)
  msg_group                 msg_group[]
  plan                      plan?                       @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_patientplan_plan")
  patient_plan_schedule     patient_plan_schedule[]
  patient_plan_schedule_log patient_plan_schedule_log[]
  plan_user                 plan_user[]
}

model patient_plan_schedule {
  id                        Int                         @id @default(autoincrement())
  patientId                 Int
  clientId                  Int?                        @default(1)
  planID                    Int
  type                      schedule_type?              @default(None)
  typeID                    Int
  scheduleDate              DateTime                    @postgresDb.Timestamp(6)
  frequencyUnit             frequency_unit_type?
  frequencyValue            Int?
  scheduleUnit              String?                     @postgresDb.VarChar(50)
  scheduleUnitValue         Decimal?                    @postgresDb.Decimal(10, 2)
  measurementUnit           measurement_unit_type?
  validFrom                 DateTime?                   @postgresDb.Date
  validTo                   DateTime?                   @postgresDb.Date
  status                    Boolean?                    @default(true)
  crUser                    String                      @postgresDb.VarChar(50)
  crDate                    DateTime?                   @default(now()) @postgresDb.Timestamp(6)
  modUser                   String                      @postgresDb.VarChar(50)
  modDate                   DateTime?                   @default(now()) @postgresDb.Timestamp(6)
  patient_plan              patient_plan                @relation(fields: [planID], references: [id], map: "fk_patient_plan_schedule_user_plan")
  patient_plan_schedule_log patient_plan_schedule_log[]
}

model patient_plan_schedule_log {
  id                    Int                    @id @default(autoincrement())
  patientPlanScheduleId Int
  patientId             Int
  clientId              Int?                   @default(1)
  planID                Int
  type                  schedule_type?         @default(None)
  typeId                Int
  scheduleDate          DateTime?              @postgresDb.Timestamp(6)
  frequencyUnit         frequency_unit_type?
  frequencyValue        Int?
  scheduleUnit          String?                @postgresDb.VarChar(50)
  scheduleUnitValue     Decimal?               @postgresDb.Decimal(10, 2)
  measurementUnit       measurement_unit_type?
  validFrom             DateTime?              @postgresDb.Date
  validTo               DateTime?              @postgresDb.Date
  status                Boolean?               @default(true)
  crUser                String                 @postgresDb.VarChar(50)
  crDate                DateTime?              @default(now()) @postgresDb.Timestamp(6)
  modUser               String                 @postgresDb.VarChar(50)
  modDate               DateTime?              @default(now()) @postgresDb.Timestamp(6)
  patient_plan          patient_plan           @relation(fields: [planID], references: [id], map: "fk_patient_plan_schedule_log_user_plan")
  patient_plan_schedule patient_plan_schedule  @relation(fields: [patientPlanScheduleId], references: [id], map: "fk_patient_plan_schedule_log_user_plan_schedule")
}

model plan {
  id            Int            @id @default(autoincrement())
  clientId      Int
  name          String         @postgresDb.VarChar(100)
  description   String?
  diagnosisId   Int
  diagnosisName String         @postgresDb.VarChar(100)
  version       Int?           @default(1)
  model         Json?          @postgresDb.Json
  crUser        String         @postgresDb.VarChar(50)
  crDate        DateTime?      @default(now()) @postgresDb.Timestamp(6)
  modUser       String         @postgresDb.VarChar(50)
  modDate       DateTime?      @default(now()) @postgresDb.Timestamp(6)
  patient_plan  patient_plan[]
}

model plan_user {
  id            Int            @id @default(autoincrement())
  clientId      Int
  patientPlanId Int
  userId        Int
  userType      user_type_enum
  crUser        String         @postgresDb.VarChar(50)
  crDate        DateTime?      @default(now()) @postgresDb.Timestamp(6)
  modUser       String         @postgresDb.VarChar(50)
  modDate       DateTime?      @default(now()) @postgresDb.Timestamp(6)
  client        client         @relation(fields: [clientId], references: [id], map: "fk_planuser_client")
  patient_plan  patient_plan   @relation(fields: [patientPlanId], references: [id], map: "fk_planuser_patient_plan")
  user          user           @relation(fields: [userId], references: [id], map: "fk_planuser_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model role {
  id          Int         @id @default(autoincrement())
  name        String      @postgresDb.VarChar(100)
  description String?     @postgresDb.VarChar(100)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime    @default(now()) @postgresDb.Timestamp(6)
  modUser     String      @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)
  user_role   user_role[]
}

model ssi_data {
  id                Int       @id @default(autoincrement())
  ssiImageUrl       String?   @postgresDb.VarChar(500)
  ssiClassification String?   @postgresDb.VarChar(100)
  ssiComment        String?
  gender            String?   @postgresDb.VarChar(50)
  age               Int?
  bmi               Float?
  dateOfSurgery     DateTime? @postgresDb.Date
  imgTakenDate      DateTime? @postgresDb.Timestamp(6)
  typeOfSurgery     String?   @postgresDb.VarChar(100)
  woundLocation     String?   @postgresDb.VarChar(100)
  diabetesFlag      Boolean?
  smokingFlag       Boolean?
  imgCaptureDevice  String?   @postgresDb.VarChar(255)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user {
  id                    Int                     @id @default(autoincrement())
  clientId              Int
  userTypeId            Int
  loginName             String                  @unique(map: "uk_user_login_name") @postgresDb.VarChar(50)
  firstName             String?                 @postgresDb.VarChar(50)
  middleName            String?                 @postgresDb.VarChar(50)
  lastName              String?                 @postgresDb.VarChar(50)
  email                 String?                 @unique(map: "uk_user_email") @postgresDb.VarChar(100)
  dob                   DateTime?               @postgresDb.Date
  mrn                   String?                 @postgresDb.VarChar(50)
  gender                String?                 @postgresDb.VarChar(50)
  timeZone              String?                 @postgresDb.VarChar(100)
  profilePicture        String?                 @postgresDb.VarChar(2000)
  passExpireInDays      Int?
  extraInfo             Json?                   @postgresDb.Json
  status                Int?
  crUser                String                  @postgresDb.VarChar(50)
  crDate                DateTime                @default(now()) @postgresDb.Timestamp(6)
  modUser               String                  @postgresDb.VarChar(50)
  modDate               DateTime?               @default(now()) @postgresDb.Timestamp(6)
  contact               contact[]
  msg_group             msg_group[]
  msg_group_participant msg_group_participant[]
  msg_group_relation    msg_group_relation[]
  msg_reply_template    msg_reply_template[]
  password              password[]
  patient_form          patient_form[]
  plan_user             plan_user[]
  client                client                  @relation(fields: [clientId], references: [id], map: "fk_user_client")
  user_type             user_type               @relation(fields: [userTypeId], references: [id], map: "fk_user_user_type")
  user_feedback         user_feedback[]
  user_role             user_role[]
}

model user_feedback {
  id       Int       @id @default(autoincrement())
  userId   Int
  clientId Int
  feedback String?
  isBug    Boolean?  @default(false)
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime? @default(now()) @postgresDb.Timestamp(6)
  modUser  String    @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], map: "fk_userfeedback_client")
  user     user      @relation(fields: [userId], references: [id], map: "fk_userfeedback_user")
}

model user_role {
  id       Int       @id @default(autoincrement())
  userId   Int
  clientId Int
  roleId   Int
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String    @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], map: "fk_user_role_client")
  role     role      @relation(fields: [roleId], references: [id], map: "fk_user_role_role")
  user     user      @relation(fields: [userId], references: [id], map: "fk_user_role_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_type {
  id          Int       @id @default(autoincrement())
  name        String    @postgresDb.VarChar(100)
  description String?   @postgresDb.VarChar(100)
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String    @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  user        user[]
}

enum box_type_enum {
  Inbox
  Archive
  Deleted
}

enum dosage_form_type {
  Tablet
  Capsule
  Liquid
  Injection
  Cream
  Ointment
  Patch
  Spray
  Drop
  Inhaler
  Other
}

enum frequency_unit_type {
  Day
  Week
}

enum literality_enum {
  Left
  Right
  Bilateral
  None
}

enum measurement_unit_type {
  Count
  Steps
}

enum media_type_enum {
  Image
  Video
  Audio
  Document
  Link
}

enum message_type_enum {
  text
  html
  submit_img
  review_img
}

enum msg_group_type_enum {
  Group
}

enum schedule_type {
  Exercise
  Goal
  Medication
  None
}

enum unit_type {
  Set
  Steps
  Duration
}

enum user_type_enum {
  Surgen
  Clinical_Staff
  Office_Staff
  Patient
}
