generator postgresClient {
  provider = "prisma-client-js"
  output   = "./generated/postgres-client"
}

datasource postgresDb {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

/// Client model with relationships
model client {
  id          Int               @id @default(autoincrement())
  name        String            @postgresDb.VarChar(100)
  description String?
  timeZone    String?           @postgresDb.VarChar(100)
  status      Int?              @default(-1)
  logo        String?           @postgresDb.VarChar(2000)
  favIcon     String?           @postgresDb.VarChar(2000)
  language    String?           @postgresDb.VarChar(50)
  website     String?           @postgresDb.VarChar(2000)
  extraInfo   Json?             @postgresDb.Json
  crUser      String            @postgresDb.VarChar(50)
  crDate      DateTime          @default(now()) @postgresDb.Timestamp(6)
  modUser     String?           @postgresDb.VarChar(50)
  modDate     DateTime?         @default(now()) @postgresDb.Timestamp(6)
  locations   client_location[]
  contacts    contact[]
  users       user[]
  userRoles   user_role[]
}

/// Client location model with relationships
model client_location {
  id          Int       @id @default(autoincrement())
  clientId    Int
  name        String    @postgresDb.VarChar(100)
  description String?
  status      Int?
  logo        String?   @postgresDb.VarChar(2000)
  extraInfo   Json?     @postgresDb.Json
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String?   @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  client      client    @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_client_location_client")
  contacts    contact[]

  @@unique([clientId, name], map: "uk_client_location_name")
  @@index([clientId, status], map: "idx_client_location_client_status")
}

/// Contact model with relationships
model contact {
  id         Int              @id @default(autoincrement())
  type       String           @postgresDb.VarChar(50)
  value      Json             @postgresDb.Json
  userId     Int?
  clientId   Int?
  locationId Int?
  default    Boolean?         @default(false)
  status     String?          @postgresDb.VarChar(5)
  crUser     String           @postgresDb.VarChar(50)
  crDate     DateTime         @default(now()) @postgresDb.Timestamp(6)
  modUser    String?          @postgresDb.VarChar(50)
  modDate    DateTime?        @default(now()) @postgresDb.Timestamp(6)
  client     client?          @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_contact_client")
  location   client_location? @relation(fields: [locationId], references: [id], onDelete: Cascade, map: "fk_contact_location")
  user       user?            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_contact_user")
}

/// Password model with relationships
model password {
  id         Int       @id @default(autoincrement())
  userId     Int
  password   String    @postgresDb.VarChar(60)
  expiryDate DateTime? @postgresDb.Date
  status     Int?
  crUser     String    @postgresDb.VarChar(50)
  crDate     DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser    String?   @postgresDb.VarChar(50)
  modDate    DateTime? @default(now()) @postgresDb.Timestamp(6)
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_password_user")

  @@index([userId, status], map: "idx_password_user_status")
}

/// Role model with relationships
model role {
  id          Int         @id @default(autoincrement())
  name        String      @postgresDb.VarChar(100)
  description String?     @postgresDb.VarChar(100)
  crUser      String      @postgresDb.VarChar(50)
  crDate      DateTime    @default(now()) @postgresDb.Timestamp(6)
  modUser     String?     @postgresDb.VarChar(50)
  modDate     DateTime?   @default(now()) @postgresDb.Timestamp(6)
  userRoles   user_role[]
}

/// User model with relationships
model user {
  id               Int         @id @default(autoincrement())
  clientId         Int
  userTypeId       Int
  loginName        String      @postgresDb.VarChar(50)
  firstName        String?     @postgresDb.VarChar(50)
  middleName       String?     @postgresDb.VarChar(50)
  lastName         String?     @postgresDb.VarChar(50)
  email            String?     @postgresDb.VarChar(100)
  dob              DateTime?   @postgresDb.Date
  mrn              String?     @postgresDb.VarChar(50)
  gender           String?     @postgresDb.VarChar(50)
  timeZone         String?     @postgresDb.VarChar(100)
  profilePicture   String?     @postgresDb.VarChar(2000)
  passExpireInDays Int?
  extraInfo        Json?       @postgresDb.Json
  status           Int?
  crUser           String      @postgresDb.VarChar(50)
  crDate           DateTime    @default(now()) @postgresDb.Timestamp(6)
  modUser          String?     @postgresDb.VarChar(50)
  modDate          DateTime?   @default(now()) @postgresDb.Timestamp(6)
  contacts         contact[]
  passwords        password[]
  client           client      @relation(fields: [clientId], references: [id], map: "fk_user_client")
  userType         user_type   @relation(fields: [userTypeId], references: [id], map: "fk_user_user_type")
  userRoles        user_role[]

  @@unique([loginName, clientId], map: "uk_user_login_client")
}

/// User role model with relationships
model user_role {
  id       Int       @id @default(autoincrement())
  userId   Int
  clientId Int
  roleId   Int
  crUser   String    @postgresDb.VarChar(50)
  crDate   DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser  String?   @postgresDb.VarChar(50)
  modDate  DateTime? @default(now()) @postgresDb.Timestamp(6)
  client   client    @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "fk_user_role_client")
  role     role      @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "fk_user_role_role")
  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_role_user")

  @@unique([userId, clientId, roleId], map: "uk_user_role_assignment")
  @@index([clientId], map: "idx_user_role_client")
  @@index([userId], map: "idx_user_role_user")
}

/// User type model with relationships
model user_type {
  id          Int       @id @default(autoincrement())
  name        String    @postgresDb.VarChar(100)
  description String?   @postgresDb.VarChar(100)
  crUser      String    @postgresDb.VarChar(50)
  crDate      DateTime  @default(now()) @postgresDb.Timestamp(6)
  modUser     String?   @postgresDb.VarChar(50)
  modDate     DateTime? @default(now()) @postgresDb.Timestamp(6)
  users       user[]
}

model india {
  id         Int     @id
  name       String? @postgresDb.VarChar(50)
  new_column String? @postgresDb.VarChar(50)
}
